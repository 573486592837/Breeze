@@ -0,0 +1,21 @@
+"""feat03 验收测试：[eval] 配置段与默认 repeat。"""
+
+import os
+
+from breeze.config import DEFAULTS, Settings
+
+
+def test_defaults_contain_eval_section() -> None:
+    assert DEFAULTS["eval"]["default_repeat"] == 1
+
+
+def test_settings_reads_eval_default_repeat(tmp_path, monkeypatch) -> None:
+    for key in list(os.environ):
+        if key.startswith("BREEZE_"):
+            monkeypatch.delenv(key, raising=False)
+    monkeypatch.setenv("SILICONFLOW_API_KEY", "test-key")
+    (tmp_path / "breeze.toml").write_text("[eval]\ndefault_repeat = 3\n", encoding="utf-8")
+
+    s = Settings(repo_root=tmp_path)
+
+    assert s.eval_default_repeat == 3
