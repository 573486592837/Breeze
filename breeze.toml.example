# Breeze configuration example.
#
# Copy this file to either:
#   - breeze.toml in your repository root (highest precedence)
#   - ~/.breeze/config.toml (user-wide default)
#
# Precedence (low to high):
#   code defaults < user config < repo config < BREEZE_* env vars < CLI flags
#
# Security parameters (whitelists, protected paths, size limits) and
# tool-schema defaults are NOT configurable here. See config.py.

[llm]
# LiteLLM model identifier. Must include the openai/ prefix so LiteLLM
# routes requests through the OpenAI-compatible endpoint.
model = "openai/Pro/deepseek-ai/DeepSeek-V3.2"
api_base = "https://api.siliconflow.cn/v1"
temperature = 0.0

[agent]
# Maximum agent loop steps per run.
max_steps = 10
# Maximum apply_patch calls per run before further edits are rejected.
max_edit_attempts = 5

[context]
# Set to false to disable context management entirely.
enable = true
# Real-token budget for one user-turn episode (tiktoken). Only when the
# turn exceeds it are the oldest read_file results demoted to pointers.
intra_turn_budget = 24000
# Maximum entries per section in the structured session-state block
# (symbols, reads, edits) injected with the summary on compression.
state_max_entries = 8
# Tool results above this size are compacted to head + tail (fallback
# only; per-tool caps align with this budget).
tool_result_max_bytes = 16000
tool_result_head_bytes = 8000
tool_result_tail_bytes = 8000

[trace]
# Directory for JSONL trace files.
dir = "traces"