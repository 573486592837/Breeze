# 复制为 .env（放在你运行 breeze 的目录，或它的任意父目录——最近的一份生效）。
# 向上查找由 Breeze 自己实现，与安装方式无关（editable 与 wheel 安装同规则）。
# 已存在的同名环境变量优先级更高，所以也可以用
#   $env:BREEZE_API_KEY = "sk-..."            # 仅当前 PowerShell 会话
#   系统设置 → 环境变量 → 用户变量             # 永久
# 代替 .env。密钥永远不进 breeze.toml，也不进 git。
# 换服务商时保持变量名不变，或在 breeze.toml 的 [llm] api_key_env 指定新名字。
BREEZE_API_KEY=sk-your-key-here
BREEZE_MODEL=openai/Pro/deepseek-ai/DeepSeek-V3.2
BREEZE_API_BASE=https://api.siliconflow.cn/v1
# 避免 LiteLLM 启动时联网拉取模型成本映射表
LITELLM_LOCAL_MODEL_COST_MAP=True
