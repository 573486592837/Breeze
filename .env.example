# 复制为 .env（同一目录，或你运行 breeze 的任意父目录——python-dotenv 会向上查找）。
# 已存在的同名环境变量优先级更高，所以也可以用
#   $env:SILICONFLOW_API_KEY = "sk-..."        # 仅当前 PowerShell 会话
#   系统设置 → 环境变量 → 用户变量             # 永久
# 代替 .env。密钥永远不进 breeze.toml，也不进 git。
SILICONFLOW_API_KEY=sk-your-key-here
BREEZE_MODEL=openai/Pro/deepseek-ai/DeepSeek-V3.2
BREEZE_API_BASE=https://api.siliconflow.cn/v1
# 避免 LiteLLM 启动时联网拉取模型成本映射表
LITELLM_LOCAL_MODEL_COST_MAP=True
